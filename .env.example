# Copie ce fichier en .env pour un test local. NE PAS committer .env.
# En production, ces valeurs se mettent dans le dashboard Render (Environment).

# Base Postgres (Neon recommandé — gratuit & persistant). Garde ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Clé de session Flask — mets une chaîne aléatoire longue.
SECRET_KEY=change-moi-avec-une-chaine-aleatoire

# Mot de passe du back-office /admin — mets un mot de passe fort.
ADMIN_PASSWORD=change-moi

# URL publique du site.
SITE_URL=https://www.cantinafragapane.be

# Emails de réservation (optionnel). SMTP Office365 déjà configuré dans app.py.
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TO=
